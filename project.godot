; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VoidScape"
config/tags=PackedStringArray("gamejam")
run/main_scene="res://Scenes/start_menu.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://Assets/Audio/Audio Mixer.tres"

[autoload]

Utils="*res://Global/utils.gd"
QuestManager="*res://Global/quest_manager.gd"
Game="*res://Global/Game.cs"

[display]

window/size/always_on_top=true
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Desktop"

[editor_plugins]

enabled=PackedStringArray()

