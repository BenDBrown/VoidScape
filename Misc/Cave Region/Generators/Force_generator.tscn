[sub_resource type="GDScript" id="GDScript_u6h5v"]
script/source = "extends Node2D

@onready var blue: PointLight2D = $Blue
@onready var red: PointLight2D = $Red

@export var interval_seconds = 1.0

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func TurnOnBlue() -> void:
	blue.visible = true
	red.visible = false
	
func TurnOnRed() -> void:
	blue.visible = false
	red.visible = true
	
"

